@baseUrl = http://localhost:3000

##################################################
# ROOT
##################################################

### API Root
GET {{baseUrl}}/


##################################################
# EXPENSES
##################################################

### Get all expenses
GET {{baseUrl}}/expenses


### Get expense by ID
# Replace EXPENSE_ID with a real MongoDB ID
GET {{baseUrl}}/expenses/EXPENSE_ID


### Create expense
POST {{baseUrl}}/expenses
Content-Type: application/json

{
  "description": "Supermarket",
  "amount": 125.50,
  "category": "Food",
  "date": "2026-09-25",
  "paymentMethod": "Credit Card",
  "isRecurring": false,
  "notes": "Weekly groceries"
}


### Create another expense
POST {{baseUrl}}/expenses
Content-Type: application/json

{
  "description": "Netflix",
  "amount": 15.99,
  "category": "Entertainment",
  "date": "2026-09-20",
  "paymentMethod": "Debit Card",
  "isRecurring": true,
  "notes": "Monthly subscription"
}


### Test expense validation
POST {{baseUrl}}/expenses
Content-Type: application/json

{
  "description": "",
  "amount": -50,
  "category": "",
  "date": "invalid-date",
  "paymentMethod": "",
  "isRecurring": "yes",
  "notes": 123
}


### Update expense
# Replace EXPENSE_ID with a real MongoDB ID
PUT {{baseUrl}}/expenses/EXPENSE_ID
Content-Type: application/json

{
  "description": "Supermarket Updated",
  "amount": 150.75,
  "category": "Food",
  "date": "2026-09-25",
  "paymentMethod": "Credit Card",
  "isRecurring": false,
  "notes": "Updated grocery expense"
}


### Delete expense
# Replace EXPENSE_ID with a real MongoDB ID
DELETE {{baseUrl}}/expenses/EXPENSE_ID


### Confirm expense was deleted
GET {{baseUrl}}/expenses/EXPENSE_ID


