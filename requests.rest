@baseUrl = http://localhost:3000


##################################################
# ROOT
##################################################

### API Root
GET {{baseUrl}}/


### Swagger Documentation
GET {{baseUrl}}/api-docs


##################################################
# AUTHENTICATION
##################################################

### Register a new user
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Anibal",
  "email": "anibal@example.com",
  "password": "Password123!"
}


### Register another user
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "John Doe",
  "email": "john@example.com",
  "password": "Password123!"
}


### Test registration validation
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "",
  "email": "invalid-email",
  "password": "123"
}


### Login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "anibal@example.com",
  "password": "Password123!"
}


### Test login with wrong password
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "anibal@example.com",
  "password": "WrongPassword123!"
}


### Test login validation
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "",
  "password": ""
}


### Get current authenticated user
GET {{baseUrl}}/auth/me


### GitHub OAuth login
GET {{baseUrl}}/auth/github


### Logout
POST {{baseUrl}}/auth/logout


##################################################
# AUTHENTICATION TESTS
##################################################

### Try to access expenses without authentication
# Run this AFTER logout
GET {{baseUrl}}/expenses


### Try to access categories without authentication
# Run this AFTER logout
GET {{baseUrl}}/categories


##################################################
# EXPENSES
##################################################

### Get all expenses
# Requires authentication
GET {{baseUrl}}/expenses


### Get expense by ID
# Replace EXPENSE_ID with a real MongoDB ID
GET {{baseUrl}}/expenses/EXPENSE_ID


### Create expense
POST {{baseUrl}}/expenses
Content-Type: application/json

{
  "description": "Supermarket",
  "amount": 125.50,
  "category": "Food",
  "date": "2026-10-05",
  "paymentMethod": "Credit Card",
  "isRecurring": false,
  "notes": "Weekly groceries"
}


### Create another expense
POST {{baseUrl}}/expenses
Content-Type: application/json

{
  "description": "Netflix",
  "amount": 15.99,
  "category": "Entertainment",
  "date": "2026-10-01",
  "paymentMethod": "Credit Card",
  "isRecurring": true,
  "notes": "Monthly subscription"
}


